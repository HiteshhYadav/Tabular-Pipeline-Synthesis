# One key is enough. The numbered ones are optional: when more than one is
# set, requests round-robin across them and a 429 fails over to the next,
# which matters because the free tier's daily quota is per project.
GOOGLE_API_KEY=
GOOGLE_API_KEY1=
GOOGLE_API_KEY2=
GOOGLE_API_KEY3=
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_S=60

DEPLOYMENT_ENV=local          # local | hosted
ENABLE_LOCAL_EXECUTION=false  # refuses to start if true and DEPLOYMENT_ENV != local
EXECUTION_TIMEOUT_S=60
EXECUTION_SAMPLE_ROWS=500
RUNNER_PYTHON=.venv-runner/bin/python
EXECUTION_BACKEND=subprocess  # subprocess | docker (docker: build runner.Dockerfile first)
EXECUTION_DOCKER_IMAGE=autonexus-runner:latest

UPLOAD_DIR=./data/uploads
DB_PATH=./data/app.db
DATASET_TTL_HOURS=24
MAX_FILE_MB=50
MAX_COLS=1000

# Comma-separated bearer tokens. Empty = no auth (local only).
# Required for DEPLOYMENT_ENV=hosted; the server refuses to start without it.
API_TOKENS=

# Per-client limits. Defaults are the defended constants in app/heuristics.py.
RATE_LIMIT_GENERATIONS_PER_HOUR=10
RATE_LIMIT_UPLOADS_PER_HOUR=30
RATE_LIMIT_EXECUTIONS_PER_HOUR=30
RATE_LIMIT_REQUESTS_PER_MINUTE=120

CORS_ORIGINS=http://localhost:5173
